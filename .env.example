# Required: your OpenAI API key
OPENAI_API_KEY=

# Optional: any GPT model that supports tool calling (default: gpt-5.4-mini)
# OPENAI_MODEL=gpt-5.4-mini
# Optional: reasoning effort for reasoning models (low | medium | high)
# OPENAI_REASONING_EFFORT=low
# Optional: timeout for one OpenAI request, in seconds (default: 60)
# OPENAI_TIMEOUT_S=60

# Optional agent settings
# TRIAGE_MAX_STEPS=8
# TRIAGE_CONFIDENCE_THRESHOLD=0.6
# TRIAGE_DATA_DIR=./data
